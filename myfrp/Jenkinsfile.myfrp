// ============================================================
// Jenkinsfile — 🌐 myfrp FRP管理面板
// ============================================================
//
// 项目信息:
//   名称: myfrp (FRP管理面板)
//   语言: Java (Spring Boot) + Vue3 (前端)
//   端口: 18082
//   部署目标: mykng (100.93.36.113)
//   容器名: frp-manager
//
// 特点:
//   - 前后端分离，前端构建后可能需要集成到后端
// ============================================================

pipeline {
    agent any
    
    options {
        timeout(time: 25, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
    }
    
    environment {
        MAVEN_OPTS = '-Xmx512m -Dmaven.repo.local=/root/.m2/repository'
    }
    
    stages {
        stage('📋 准备环境') {
            steps {
                echo "============================================="
                echo "  🌐 myfrp FRP管理面板"
                echo "  时间: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                echo "  Commit: ${GIT_COMMIT}"
                echo "============================================="
            }
        }
        
        stage('🔨 构建前端') {
            when {
                expression { fileExists('myfrp/frontend/package.json') }
            }
            steps {
                sh '''
                    echo ">>> [myfrp] 构建前端 <<<"
                    cd myfrp/frontend
                    
                    if [ ! -d "node_modules" ]; then
                        npm ci --registry=https://registry.npmmirror.com
                    fi
                    
                    npm run build
                    
                    cd ../..
                    
                    echo "✅ 前端构建完成"
                    ls -lh myfrp/frontend/dist/ | head -5
                '''
            }
        }
        
        stage('🔨 Maven 编译后端') {
            steps {
                milestone(label: 'myfrp-build')
                sh '''
                    echo ">>> [myfrp] Maven 编译后端 <<<"
                    cd myfrp
                    
                    mvn clean package -DskipTests -B -V -ntp -Pfast
                    
                    cd ..
                    
                    echo "=== 编译产物 ==="
                    ls -lh myfrp/target/*.jar | grep -v original || echo "⚠️ jar 不存在"
                '''
            }
        }
        
        stage('🚀 部署到 mykng') {
            steps {
                milestone(label: 'myfrp-deploy')
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                chmod +x /root/devtools/myfrp/ci/deploy.sh
                                bash /root/devtools/myfrp/ci/deploy.sh "${GIT_COMMIT}" "${env.GIT_BRANCH}"
                            """,
                            execTimeout: 600000
                        )],
                        verbose: true
                    )]
                )
            }
        }
        
        stage('✅ 健康检查') {
            steps {
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                echo "--- FRP面板健康检查 (端口 18082) ---"
                                for i in \$(seq 1 8); do
                                    if curl -sf http://localhost:18082/ > /dev/null 2>&1; then
                                        echo "✅ FRP面板健康! (尝试 \$i)"
                                        exit 0
                                    fi
                                    sleep 8
                                done
                                echo "❌ 服务未响应"
                                exit 1
                            """,
                            execTimeout: 120000
                        )],
                        verbose: true
                    )]
                )
            }
        }
    }
    
    post {
        always {
            echo "============================================="
            echo "  myfrp 构建结束: ${currentBuild.result ?: 'SUCCESS'}"
            echo "============================================="
            cleanWs(cleanWhenNotFailed: false, deleteDirs: true)
        }
        success { echo "✅ myfrp 部署成功" }
        failure { echo "❌ myfrp 失败" }
    }
}
