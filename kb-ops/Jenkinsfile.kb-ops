// ============================================================
// Jenkinsfile — ⚙️ kb-ops 运维平台
// ============================================================
//
// 项目信息:
//   名称: kb-ops (运维平台)
//   语言: Java / Maven
//   端口: 8084
//   部署目标: mykng (100.93.36.113)
//   容器名: kb-ops
//
// 注意: 首次部署会自动创建 docker-compose.yml
// ============================================================

pipeline {
    agent any
    
    parameters {
        choice(
            name: 'DEPLOY_TARGET',
            choices: ['production', 'test'],
            description: '🌍 部署目标环境'
        )
    }
    
    options {
        timeout(time: 25, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
    }
    
    environment {
        MAVEN_OPTS = '-Xmx1024m -Dmaven.repo.local=/root/.m2/repository'
    }
    
    stages {
        stage('📋 准备环境') {
            steps {
                echo "============================================="
                echo "  ⚙️ kb-ops 运维平台"
                echo "  时间: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                echo "  Commit: ${GIT_COMMIT}"
                echo "============================================="
            }
        }
        
        stage('🔨 Maven 编译') {
            steps {
                milestone(label: 'kb-ops-build')
                sh '''
                    echo ">>> [kb-ops] Maven 编译 <<<"
                    cd kb-ops
                    
                    mvn clean package -DskipTests -B -V -ntp -Pfast
                    
                    cd ..
                    
                    echo "=== 编译产物 ==="
                    ls -lh kb-ops/target/*.jar | grep -v original || echo "⚠️ jar 不存在"
                '''
            }
        }
        
        stage('🚀 部署到 mykng') {
            steps {
                milestone(label: 'kb-ops-deploy')
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [
                            // 1. 创建目标目录
                            sshTransfer(
                                execCommand: "mkdir -p /root/devtools/kb-ops/target",
                                execTimeout: 30000
                            ),
                            // 2. 传输 JAR 包（Docker build 需要）
                            sshTransfer(
                                sourceFiles: 'kb-ops/target/*.jar',
                                removePrefix: 'kb-ops',
                                remoteDirectory: '/root/devtools/kb-ops',
                                execTimeout: 120000
                            ),
                            // 3. 执行部署脚本
                            sshTransfer(
                                execCommand: """
                                    chmod +x /root/devtools/kb-ops/ci/deploy.sh
                                    bash /root/devtools/kb-ops/ci/deploy.sh "${GIT_COMMIT}" "${env.GIT_BRANCH}"
                                """,
                                execTimeout: 600000
                            )
                        ],
                        verbose: true
                    )]
                )
            }
        }
        
        stage('✅ 健康检查') {
            steps {
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                echo "--- kb-ops 健康检查 (端口 8084) ---"
                                for i in \$(seq 1 8); do
                                    if curl -sf http://localhost:8084/actuator/health > /dev/null 2>&1 || \\
                                       curl -sf http://localhost:8084/ > /dev/null 2>&1; then
                                        echo "✅ kb-ops 服务健康! (尝试 \$i)"
                                        exit 0
                                    fi
                                    sleep 8
                                done
                                echo "❌ 服务未响应"
                                exit 1
                            """,
                            execTimeout: 120000
                        )],
                        verbose: true
                    )]
                )
            }
        }
    }
    
    post {
        always {
            echo "============================================="
            echo "  kb-ops 构建结束: ${currentBuild.result ?: 'SUCCESS'}"
            echo "============================================="
            cleanWs(cleanWhenNotFailed: false, deleteDirs: true)
        }
        success { echo "✅ kb-ops 部署成功" }
        failure { echo "❌ kb-ops 失败" }
    }
}
