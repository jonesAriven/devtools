// ============================================================
// Jenkinsfile — 🚪 portal 门户系统
// ============================================================
//
// 项目信息:
//   名称: portal (devtools-portal)
//   技术栈: TypeScript / Vue3 / Vite / Element Plus
//   构建工具: npm / pnpm
//   端口: 8087 (后端API) + Nginx 静态文件 (前端)
//   部署目标: mykng (100.93.36.113)
//   部署方式:
//     - 前端: Nginx 静态文件 (/var/www/portal)
//     - 后端: Java 直接进程 (:8087, JAR在 /opt/portal-server/)
//
// 特点:
//   - 前后端分离部署
//   - 前端 Vue3 构建 → 静态文件
//   - 后端 Maven 构建 → JAR → nohup 进程
// ============================================================

pipeline {
    agent any
    
    options {
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
    }
    
    stages {
        stage('📋 准备环境') {
            steps {
                echo "============================================="
                echo "  🚪 portal 门户系统"
                echo "  时间: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                echo "  Commit: ${GIT_COMMIT}"
                echo "============================================="
                
                sh '''
                    node --version
                    npm --version
                '''
            }
        }
        
        stage('📦 安装依赖 & 构建') {
            steps {
                milestone(label: 'portal-build')
                sh '''
                    echo ">>> [portal] 安装依赖 & 构建 <<<"
                    cd portal
                    
                    # 安装依赖（使用国内镜像）
                    if [ ! -d "node_modules" ]; then
                        npm ci --registry=https://registry.npmmirror.com
                    fi
                    
                    # 构建
                    npm run build
                    
                    cd ..
                    
                    echo "=== 构建产物 ==="
                    ls -lh portal/dist/ | head -10
                    du -sh portal/dist/
                '''
            }
        }
        
        stage('🚀 部署到 mykng') {
            steps {
                milestone(label: 'portal-deploy')
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [
                            // 1. 创建目标目录
                            sshTransfer(
                                execCommand: "mkdir -p /root/devtools/portal/dist /root/devtools/portal/portal-server/target",
                                execTimeout: 30000
                            ),
                            // 2. 传输前端构建产物
                            sshTransfer(
                                sourceFiles: 'portal/dist/**',
                                removePrefix: 'portal/dist',
                                remoteDirectory: '/root/devtools/portal/dist',
                                execTimeout: 120000
                            ),
                            // 3. 执行部署脚本（后端由 deploy.sh 在服务器上 Maven 构建）
                            sshTransfer(
                                execCommand: """
                                    chmod +x /root/devtools/portal/ci/deploy.sh
                                    bash /root/devtools/portal/ci/deploy.sh "${GIT_COMMIT}" "${env.GIT_BRANCH}"
                                """,
                                execTimeout: 600000
                            )
                        ],
                        verbose: true
                    )]
                )
            }
        }
        
        stage('✅ 验证部署') {
            steps {
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                echo "--- Portal 验证 ---"
                                if [ -d "/var/www/portal" ]; then
                                    echo "✅ 静态文件已部署"
                                    ls -la /var/www/portal/ | head -5
                                elif docker ps --filter "name=portal" --format "{{.Names}}" | grep -q portal; then
                                    echo "✅ Docker 容器运行中"
                                    docker ps --filter "name=portal" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
                                else
                                    echo "⚠️ 未检测到部署结果，请手动验证"
                                fi
                            """,
                            execTimeout: 30000
                        )],
                        verbose: true
                    )]
                )
            }
        }
    }
    
    post {
        always {
            echo "============================================="
            echo "  portal 构建结束: ${currentBuild.result ?: 'SUCCESS'}"
            echo "============================================="
            cleanWs(cleanWhenNotFailed: false, deleteDirs: true)
        }
        success { echo "✅ portal 部署成功" }
        failure { echo "❌ portal 失败" }
    }
}
