#include <windows.h>
#include "../src/Resource.h"

// 声明源文件使用 UTF-8 编码，否则中文 Windows 上 RC 编译器默认按 GBK 解析会导致中文乱码
#pragma code_page(65001)

IDR_ICON1 ICON "app.ico"

// 版本号从 CMake configure_file 注入
// FILEVERSION 需要逗号分隔数字: 2026,715,22,17 (年,月日,时,分)
1 VERSIONINFO
FILEVERSION 2026,0801,2212
PRODUCTVERSION 2026,0801,2212
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Jones"
            VALUE "FileDescription", "QR Code Tool - 二维码生成与识别工具"
            VALUE "FileVersion", "V202608012212"
            VALUE "ProductName", "QRCodeTool"
            VALUE "ProductVersion", "V202608012212"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
