#include <windows.h>
#include "../src/Resource.h"

IDR_ICON1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 2,0,7,15
PRODUCTVERSION 2,0,7,15
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Jones"
            VALUE "FileDescription", "QR Code Tool"
            VALUE "FileVersion", "2.0.07.15"
            VALUE "ProductName", "QRCodeTool"
            VALUE "ProductVersion", "2.0.07.15"
            VALUE "InternalName", "QRCodeTool"
            VALUE "OriginalFilename", "QRCodeTool.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 Jones"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
