#include <windows.h>
#include "../src/Resource.h"

IDR_ICON1 ICON "app.ico"

// 版本号从 CMake configure_file 注入
// FILEVERSION 需要逗号分隔数字: 2026,715,22,17 (年,月日,时,分)
1 VERSIONINFO
FILEVERSION @APP_VERSION_COMMA@
PRODUCTVERSION @APP_VERSION_COMMA@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Jones"
            VALUE "FileDescription", "QR Code Tool - 二维码生成与识别工具"
            VALUE "FileVersion", "@APP_VERSION@"
            VALUE "ProductName", "QRCodeTool"
            VALUE "ProductVersion", "@APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
