# ============================================================
# mykng Docker Compose 环境变量示例
# ============================================================
# 复制本文件为 .env 并修改对应值: cp .env.example .env
# 修改后执行: docker compose up -d
# ============================================================

# 统一上下文路径（前端 .env VITE_CONTEXT_PATH 必须与此一致）
KB_CONTEXT=/kb

# MySQL
MYSQL_ROOT_PASSWORD=kb123456

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MeiliSearch
MEILI_MASTER_KEY=kbMeiliKey2026!!Secure

# MongoDB
MONGO_ROOT_USER=kb
MONGO_ROOT_PASSWORD=kb123456

# JWT 密钥（必须 >= 256 bits，建议更换为随机字符串）
JWT_SECRET=YourSuperSecretKeyForJwtTokenGenerationMustBeAtLeast256BitsLong!!

# AES 加密密钥（用于 kb-auth/kb-ops 的密码加密，必须 32 字节）
CRYPTO_AES_KEY=YWVzLTI1Ni1nY20ta2V5LTMyLWJ5dGVzISE=

# kb-intelligence 可选配置
# LLM_ENABLED=false
# LLM_ENDPOINT=
# LLM_API_KEY=
# LLM_MODEL=qwen-turbo

# 知识导入源目录（挂载到 kb-intelligence 容器内 /data/import）
# IMPORT_SOURCE_DIR=/data/import
