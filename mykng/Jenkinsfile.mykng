// ============================================================
// Jenkinsfile — 📘 mykng 知识库微服务
// ============================================================
//
// 项目信息:
//   名称: mykng (知识库微服务群)
//   语言: Java / Maven
//   模块: kb-gateway, kb-auth, kb-file, kb-knowledge, kb-intelligence
//   端口: 8090(gateway), 8081(auth), 8082(file), 8083(knowledge), 8086(intelligence)
//   部署目标: mykng (100.93.36.113, Tailscale)
//   Docker Compose Project: kb-deploy
//
// 触发方式:
//   - 手动: Build with Parameters → DEPLOY_TARGET=production|test
//   - Webhook: Gitee push to dev/master branch
// ============================================================

pipeline {
    agent any
    
    parameters {
        choice(
            name: 'DEPLOY_TARGET',
            choices: ['production', 'test'],
            description: '🌍 部署目标环境'
        )
    }
    
    options {
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }
    
    environment {
        MAVEN_OPTS = '-Xmx2048m -Dmaven.repo.local=/root/.m2/repository'
        MAVEN_CLI = 'clean package -DskipTests -B -V -ntp -Pfast -T 2C'
    }
    
    triggers {
        // Gitee Webhook 自动触发（可选）
        // cron('H 9 * * *')  // 每天早上9点自动构建
    }
    
    stages {
        stage('📋 准备环境') {
            steps {
                echo "============================================="
                echo "  📘 mykng 知识库微服务"
                echo "  时间: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                echo "  环境: ${params.DEPLOY_TARGET}"
                echo "  Commit: ${GIT_COMMIT}"
                echo "============================================="
                
                sh '''
                    java -version 2>&1 | head -1
                    mvn -version 2>&1 | head -1
                    docker --version
                '''
            }
        }
        
        stage('🔨 Maven 编译') {
            steps {
                milestone(label: 'mykng-build')
                sh '''
                    echo ">>> [mykng] 开始 Maven 编译 <<<"
                    cd mykng/kb-parent
                    
                    mvn $MAVEN_CLI
                    
                    cd ../..
                    
                    echo "=== 编译产物 ==="
                    find mykng -name "*.jar" -path "*/target/*" ! -name "*original.jar" -exec ls -lh {} \\;
                '''
            }
        }
        
        stage('🚀 部署到 mykng') {
            steps {
                milestone(label: 'mykng-deploy')
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                chmod +x /root/devtools/mykng/ci/deploy.sh
                                bash /root/devtools/mykng/ci/deploy.sh "${GIT_COMMIT}" "${env.GIT_BRANCH}" "${params.DEPLOY_TARGET}"
                            """,
                            execTimeout: 900000
                        )],
                        verbose: true
                    )]
                )
            }
        }
        
        stage('✅ 健康检查') {
            steps {
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                echo "--- Gateway 健康检查 ---"
                                for i in \$(seq 1 6); do
                                    if curl -sf http://localhost:8090/kb/actuator/health > /dev/null 2>&1; then
                                        echo "✅ Gateway 健康! (尝试 \$i)"
                                        exit 0
                                    fi
                                    sleep 10
                                done
                                echo "❌ Gateway 未响应"
                                exit 1
                            """,
                            execTimeout: 120000
                        )],
                        verbose: true
                    )]
                )
            }
        }
    }
    
    post {
        always {
            echo "============================================="
            echo "  mykng 构建结束: ${currentBuild.result ?: 'SUCCESS'}"
            echo "  耗时: ${currentBuild.durationString.replace(' and counting', '')}"
            echo "============================================="
            cleanWs(cleanWhenNotFailed: false, deleteDirs: true)
        }
        success { echo "✅ mykng 部署成功" }
        failure { 
            echo "❌ mykng 构建或部署失败"
            // dingtalk(...)
        }
    }
}
