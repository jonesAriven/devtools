// ============================================================
// mykng 知识库微服务 CI/CD 流水线 (Jenkinsfile)
// ============================================================
// 流水线阶段（按 SOP V1.1）：
//   Checkout → Compile → Lint/Static Analysis → Unit Test →
//   Mutation Test → Integration Test → BDD Test → Build Docker Image →
//   Deploy to SIT → E2E Test → SonarQube → Performance Test →
//   Deploy to STAGING → Approve → Deploy to PROD
// ============================================================

pipeline {
    agent any

    environment {
        // JDK 21
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk'
        PATH      = "${env.JAVA_HOME}/bin:${env.PATH}"

        // Maven 优化
        MAVEN_OPTS = '-Xmx2048m -Dmaven.repo.local=.m2/repository -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn'
        MAVEN_CLI_OPTS = '-B -V -ntp -Dstyle.color=always'

        // Nexus 私服凭据（Jenkins -> Credentials 中配置 id=nexus-credentials）
        NEXUS_URL        = 'https://nexus.marschat.online/repository/maven-public/'

        // Docker Compose 项目名
        COMPOSE_PROJECT_NAME = 'kb-deploy'

        // 服务器（SIT/STAGING/PROD 共用，按环境变量切换目录）
        DEPLOY_HOST      = 'mykng-debain'
        DEPLOY_IP        = '192.168.31.105'
        DEPLOY_USER      = 'deploy'

        // SonarQube
        SONAR_HOST_URL   = 'https://sonar.marschat.online'

        // 测试报告根目录
        TEST_OUTPUT      = 'test-output'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    triggers {
        // 每 1 小时轮询一次 SCM（备份触发；主要靠 webhook）
        pollSCM('H H * * *')
    }

    stages {

        // ------------------------------------------------------------
        // 1. Checkout
        // ------------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.GIT_BRANCH_NAME  = env.BRANCH_NAME ?: sh(script: 'git rev-parse --abbrev-ref HEAD', returnStdout: true).trim()
                    echo "Branch: ${env.GIT_BRANCH_NAME}, Commit: ${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        // ------------------------------------------------------------
        // 2. Compile
        // ------------------------------------------------------------
        stage('Compile') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-credentials',
                                                 usernameVariable: 'NEXUS_USER',
                                                 passwordVariable: 'NEXUS_PASS')]) {
                    sh '''
                        set -e
                        mkdir -p .m2
                        cat > .m2/settings.xml <<EOF
<settings>
  <servers>
    <server>
      <id>nexus-public</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASS}</password>
    </server>
    <server>
      <id>nexus-releases</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASS}</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASS}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>nexus-public</id>
      <mirrorOf>*</mirrorOf>
      <url>${NEXUS_URL}</url>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>nexus</id>
      <repositories>
        <repository>
          <id>nexus-public</id>
          <url>${NEXUS_URL}</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>nexus-public</id>
          <url>${NEXUS_URL}</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>nexus</activeProfile>
  </activeProfiles>
</settings>
EOF
                    '''
                    sh "cd kb-parent && mvn ${MAVEN_CLI_OPTS} -s ../.m2/settings.xml clean compile -Pskip-tests"
                }
            }
        }

        // ------------------------------------------------------------
        // 3. Lint / Static Analysis（Spotless / Checkstyle / SpotBugs）
        // ------------------------------------------------------------
        stage('Lint / Static Analysis') {
            steps {
                sh "cd kb-parent && mvn ${MAVEN_CLI_OPTS} -s ../.m2/settings.xml checkstyle:check spotbugs:check -Pskip-tests || true"
            }
        }

        // ------------------------------------------------------------
        // 4. Unit Test（Surefire，输出到 test-output/unit/java/）
        // ------------------------------------------------------------
        stage('Unit Test') {
            steps {
                sh """
                    cd kb-parent && mvn ${MAVEN_CLI_OPTS} -s ../.m2/settings.xml test \\
                        -Dtest='*Test,!*IntegrationTest,!*ApplicationTests,!*IT' \\
                        -Dsurefire.failIfNoSpecifiedTests=false \\
                        -Dsurefire.reportsDir=../${TEST_OUTPUT}/unit/java/surefire-reports \\
                        -Djacoco.reportDir=../${TEST_OUTPUT}/unit/java/jacoco
                """
            }
            post {
                always {
                    junit testResults: "**/${TEST_OUTPUT}/unit/java/surefire-reports/*.xml",
                         allowEmptyResults: true,
                         skipMarkingBuildUnstable: false
                }
            }
        }

        // ------------------------------------------------------------
        // 5. Mutation Test（PITest，仅 main 分支）
        // ------------------------------------------------------------
        stage('Mutation Test') {
            when { branch 'main' }
            steps {
                sh """
                    cd kb-parent && mvn ${MAVEN_CLI_OPTS} -s ../.m2/settings.xml verify \\
                        -DskipTests=false \\
                        -Dtest='*Test,!*IntegrationTest,!*ApplicationTests,!*IT' \\
                        -Dsurefire.failIfNoSpecifiedTests=false \\
                        -Dpit.reportDir=../${TEST_OUTPUT}/mutation \\
                        -Dpit.output-formats=XML,HTML
                """
            }
            post {
                always {
                    pitmutation mutationStats: [
                        [statsThreshold: 80, mutationThreshold: 70, detectNewMutations: true]
                    ],
                    killStatsMustBeNew: false
                }
            }
        }

        // ------------------------------------------------------------
        // 6. Integration Test（Failsafe，*IT.java）
        // ------------------------------------------------------------
        stage('Integration Test') {
            steps {
                sh """
                    cd kb-parent && mvn ${MAVEN_CLI_OPTS} -s ../.m2/settings.xml \\
                        failsafe:integration-test failsafe:verify \\
                        -Dit.test='*IT,*IntegrationTest' \\
                        -DskipITs=false \\
                        -Dfailsafe.reportsDir=../${TEST_OUTPUT}/integration/java/failsafe-reports
                """
            }
            post {
                always {
                    junit testResults: "**/${TEST_OUTPUT}/integration/java/failsafe-reports/*.xml",
                         allowEmptyResults: true,
                         skipMarkingBuildUnstable: false
                }
            }
        }

        // ------------------------------------------------------------
        // 7. BDD Test（Cucumber，预留阶段）
        // ------------------------------------------------------------
        stage('BDD Test') {
            when { expression { fileExists('tests/bdd') } }
            steps {
                sh '''
                    if [ -d tests/bdd ]; then
                      cd tests/bdd && mvn ${MAVEN_CLI_OPTS} test -Dcucumber.options="--tags @smoke"
                    else
                      echo "[INFO] tests/bdd 不存在，跳过 BDD 测试"
                    fi
                '''
            }
        }

        // ------------------------------------------------------------
        // 8. Build Docker Images（docker compose build，项目名 kb-deploy）
        // ------------------------------------------------------------
        stage('Build Docker Image') {
            steps {
                sh "docker compose -p ${COMPOSE_PROJECT_NAME} build"
            }
        }

        // ------------------------------------------------------------
        // 9. Deploy to SIT（SSH 推送 + 远程拉起新版本）
        // ------------------------------------------------------------
        stage('Deploy to SIT') {
            when { anyOf { branch 'develop'; branch 'main' } }
            steps {
                sshagent(credentials: ['mykng-deploy-ssh']) {
                    sh """
                        set -e
                        echo "[INFO] 部署到 SIT 环境 (${DEPLOY_IP})..."
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_IP} \\
                            "cd /opt/kb-deploy/sit && git fetch --all && git reset --hard ${env.GIT_COMMIT_SHORT} && \\
                             docker compose -p kb-deploy-sit pull && \\
                             docker compose -p kb-deploy-sit up -d --remove-orphans"
                    """
                }
            }
        }

        // ------------------------------------------------------------
        // 10. E2E Test（Playwright，31 场景）
        // ------------------------------------------------------------
        stage('E2E Test') {
            when { anyOf { branch 'develop'; branch 'main' } }
            steps {
                sh '''
                    if [ -f tests/test_e2e.py ]; then
                      /opt/playwright-venv/bin/python tests/test_e2e.py --env sit || exit 1
                    else
                      echo "[WARN] tests/test_e2e.py 不存在，跳过 E2E 测试"
                    fi
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${TEST_OUTPUT}/e2e/playwright-report/**,${TEST_OUTPUT}/e2e/screenshots/**",
                                     allowEmptyArchive: true,
                                     fingerprint: true
                }
            }
        }

        // ------------------------------------------------------------
        // 11. SonarQube 静态扫描
        // ------------------------------------------------------------
        stage('SonarQube') {
            steps {
                withSonarQubeEnv('mykng-sonar') {
                    withCredentials([usernamePassword(credentialsId: 'nexus-credentials',
                                                     usernameVariable: 'NEXUS_USER',
                                                     passwordVariable: 'NEXUS_PASS')]) {
                        sh """
                            cd kb-parent && mvn ${MAVEN_CLI_OPTS} -s ../.m2/settings.xml sonar:sonar \\
                                -Dsonar.host.url=${SONAR_HOST_URL} \\
                                -Dsonar.projectKey=mykng \\
                                -Dsonar.branch.name=${env.GIT_BRANCH_NAME} \\
                                -Dsonar.coverage.jacoco.xmlReportPaths=../${TEST_OUTPUT}/unit/java/jacoco/jacoco.xml
                        """
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ------------------------------------------------------------
        // 12. Performance Test（k6 / wrk）
        // ------------------------------------------------------------
        stage('Performance Test') {
            when { branch 'main' }
            steps {
                sh '''
                    if [ -f tests/test_performance.py ]; then
                      python3 tests/test_performance.py --env sit || exit 1
                    else
                      echo "[WARN] tests/test_performance.py 不存在，跳过性能测试"
                    fi
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: "${TEST_OUTPUT}/performance/**",
                                     allowEmptyArchive: true
                }
            }
        }

        // ------------------------------------------------------------
        // 13. Deploy to STAGING
        // ------------------------------------------------------------
        stage('Deploy to STAGING') {
            when { branch 'main' }
            steps {
                sshagent(credentials: ['mykng-deploy-ssh']) {
                    sh """
                        set -e
                        echo "[INFO] 部署到 STAGING 环境 (${DEPLOY_IP})..."
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_IP} \\
                            "cd /opt/kb-deploy/staging && git fetch --all && git reset --hard ${env.GIT_COMMIT_SHORT} && \\
                             docker compose -p kb-deploy-staging pull && \\
                             docker compose -p kb-deploy-staging up -d --remove-orphans"
                    """
                }
            }
        }

        // ------------------------------------------------------------
        // 14. Approve（生产发布前人工审批）
        // ------------------------------------------------------------
        stage('Approve') {
            when { branch 'main' }
            steps {
                timeout(time: 24, unit: 'HOURS') {
                    input message: "确认将 ${env.GIT_COMMIT_SHORT} 部署到生产环境（PROD）？",
                          ok: '批准发布到 PROD',
                          submitter: 'release-manager,admin',
                          parameters: [
                              string(name: 'RELEASE_NOTE',
                                     defaultValue: '',
                                     description: '本次发布说明（可选）')
                          ]
                }
            }
        }

        // ------------------------------------------------------------
        // 15. Deploy to PROD
        // ------------------------------------------------------------
        stage('Deploy to PROD') {
            when { branch 'main' }
            steps {
                sshagent(credentials: ['mykng-deploy-ssh']) {
                    sh """
                        set -e
                        echo "[INFO] 部署到 PROD 环境 (${DEPLOY_IP})..."
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_IP} \\
                            "cd /opt/kb-deploy/prod && git fetch --all && git reset --hard ${env.GIT_COMMIT_SHORT} && \\
                             docker compose -p kb-deploy-prod pull && \\
                             docker compose -p kb-deploy-prod up -d --remove-orphans && \\
                             docker image prune -f"
                    """
                }
            }
            post {
                success {
                    echo "✅ PROD 部署成功: ${env.GIT_COMMIT_SHORT} (${env.GIT_BRANCH_NAME})"
                }
            }
        }
    }

    // ------------------------------------------------------------
    // Post actions
    // ------------------------------------------------------------
    post {
        always {
            // 归档测试报告
            archiveArtifacts artifacts: "${TEST_OUTPUT}/**",
                             allowEmptyArchive: true,
                             fingerprint: true
            // 发布测试结果到 Jenkins UI
            junit testResults: "**/${TEST_OUTPUT}/**/surefire-reports/*.xml,**/${TEST_OUTPUT}/**/failsafe-reports/*.xml",
                 allowEmptyResults: true
        }
        success {
            echo "🎉 Pipeline 成功: ${currentBuild.fullDisplayName}"
        }
        unstable {
            echo "⚠️ Pipeline 不稳定（测试失败或质量门禁未通过）"
        }
        failure {
            echo "❌ Pipeline 失败"
            // 可在此处接入企业微信/钉钉/Slack 通知
        }
        aborted {
            echo "🚫 Pipeline 被中止"
        }
    }
}
