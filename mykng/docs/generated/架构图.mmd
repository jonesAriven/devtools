graph TD

    %% ===== 入口层 =====
    User[用户] -->|HTTPS| kbgateway[kb-gateway<br/>:8090]
    kbgateway -->|静态资源| kbweb[kb-web<br/>:8091]

    %% ===== 网关路由（lb://）=====
    kbgateway -->|lb://| authcenter[auth-center<br/>:8085]
    kbgateway -->|lb://| kbfile[kb-file<br/>:8089]
    kbgateway -->|lb://| kbknowledge[kb-knowledge<br/>:8092]
    kbgateway -->|lb://| kbintelligence[kb-intelligence<br/>:8086]

    %% ===== 基础设施 =====
    mysql[(mysql<br/>:3306)]
    redis[(redis<br/>:6379)]
    minio[(minio<br/>:9000)]
    meilisearch[(meilisearch<br/>:7700)]
    mongodb[(mongodb<br/>:27017)]

    %% ===== 模块依赖基础设施 =====
    authcenter --> mysql
    authcenter --> redis
    kbfile --> mysql
    kbfile --> redis
    kbfile --> minio
    kbfile --> meilisearch
    kbfile --> mongodb
    kbknowledge --> mysql
    kbknowledge --> redis
    kbknowledge --> meilisearch
    kbknowledge --> mongodb
    kbintelligence --> mysql
    kbintelligence --> redis
    kbintelligence --> mongodb
    kbintelligence --> meilisearch

    %% ===== 服务发现 =====
    Nacos[(Nacos<br/>:8848)]
    kbgateway -.注册.-> Nacos
    authcenter -.注册.-> Nacos
    kbfile -.注册.-> Nacos
    kbknowledge -.注册.-> Nacos
    kbintelligence -.注册.-> Nacos

    %% ===== 样式 =====
    style kbgateway fill:#4f46e5,color:#fff,stroke:#4338ca
    style authcenter fill:#10b981,color:#fff,stroke:#10b981
    style kbfile fill:#10b981,color:#fff,stroke:#10b981
    style kbknowledge fill:#10b981,color:#fff,stroke:#10b981
    style kbintelligence fill:#10b981,color:#fff,stroke:#10b981
    style kbweb fill:#64748b,color:#fff,stroke:#64748b
