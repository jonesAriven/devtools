# ============================================================
# mykng Docker Compose 环境变量
# ============================================================
# 修改后执行: docker compose up -d
# ============================================================

# 统一上下文路径（前端 .env VITE_CONTEXT_PATH 必须与此一致）
KB_CONTEXT=/kb

# MySQL
MYSQL_ROOT_PASSWORD=kb123456

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MeiliSearch
MEILI_MASTER_KEY=kbMeiliKey2026!!Secure

# MongoDB
MONGO_ROOT_USER=kb
MONGO_ROOT_PASSWORD=kb123456

# JWT 密钥（必须 >= 256 bits，建议更换为随机字符串）
JWT_SECRET=YourSuperSecretKeyForJwtTokenGenerationMustBeAtLeast256BitsLong!!

# AES 加密密钥（用于 auth-center/kb-ops 的密码加密，必须 32 字节）
CRYPTO_AES_KEY=YWVzLTI1Ni1nY20ta2V5LTMyLWJ5dGVzISE=

# ====== 菜单上报凭据（Phase 4 P-B，/internal 通道 X-Client-Secret）======
# 值须与 auth-center 侧对应 sys_app_client.client_secret 一致
# （源自 apps-registry.yml 的 menu-report-secret → clients.yml 的 ${ENV:默认}）。
# 各应用独立命名，避免共用同一变量名串值。
# kb-gateway 代 kb-web 上报（compose kb-gateway 段读取 KBWEB_MENU_REPORT_SECRET）
KBWEB_MENU_REPORT_SECRET=fff08d4f9ca92f27ffb9111d1a9b8ed9e54769c3dc279bf3
# infra-monitor 上报（infra-monitor-server/docker-compose.yml 读取 INFRAMON_MENU_REPORT_SECRET）
INFRAMON_MENU_REPORT_SECRET=fd20b92c239eaad778f750817a33e67f6bc108179c008448
