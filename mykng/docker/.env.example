# ============================================================
# mykng Docker Compose 环境变量模板
# ============================================================
# 使用: cp .env.example .env 后填入真实值
# 注意: .env 含敏感信息，绝不入库
# ============================================================

# ====== 部署路径 ======
DEPLOY_BASE=/root/kb-deploy

# ====== 统一上下文路径 ======
# 前端 .env VITE_CONTEXT_PATH 必须与此一致
KB_CONTEXT=/kb

# ====== MySQL ======
MYSQL_ROOT_PASSWORD=change-me-mysql-password

# ====== MongoDB ======
MONGO_ROOT_USER=change-me-mongo-user
MONGO_ROOT_PASSWORD=change-me-mongo-password

# ====== MinIO ======
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# ====== MeiliSearch ======
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_KEY=change-me-meili-key

# ====== Nacos ======
# Nacos 服务端用户 nacos 的密码
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos-password
NACOS_AUTH_TOKEN=change-me-nacos-token-must-be-32-bytes-or-longer-base64
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-identity-value

# ====== 应用加密 ======
# AES 加密密钥（用于 kb-auth/kb-ops 的密码加密，必须 32 字节）
CRYPTO_AES_KEY=change-me-must-be-32-bytes-exactly!

# JWT 密钥（必须 >= 32 字节）
JWT_SECRET=change-me-jwt-secret-must-be-32-bytes-or-longer
