// ============================================================
// Jenkinsfile — 📊 infra-monitor 基础设施监控
// ============================================================
//
// 项目信息:
//   名称: infra-monitor (基础设施监控)
//   后端: Java / Spring Boot (infra-monitor-server)
//   前端: Vue3 / Vite (infra-monitor-web)
//   端口: 8085 (默认)
//   部署目标: mykng (100.93.36.113)
//   容器名: infra-monitor
//
// 特点:
//   - 前后端分离，前端构建后集成到后端 JAR
// ============================================================

pipeline {
    agent any
    
    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
    }
    
    environment {
        MAVEN_OPTS = '-Xmx512m -Dmaven.repo.local=/root/.m2/repository'
    }
    
    stages {
        stage('📋 准备环境') {
            steps {
                echo "============================================="
                echo "  📊 infra-monitor 基础设施监控"
                echo "  时间: ${new Date().format('yyyy-MM-dd HH:mm:ss')}"
                echo "  Commit: ${GIT_COMMIT}"
                echo "============================================="
            }
        }
        
        stage('🔨 构建前端') {
            when {
                expression { fileExists('infra-monitor/infra-monitor-web/package.json') }
            }
            steps {
                sh '''
                    echo ">>> [infra-monitor] 构建前端 <<<"
                    cd infra-monitor/infra-monitor-web
                    
                    if [ -f "pnpm-lock.yaml" ]; then
                        if [ ! -d "node_modules" ]; then
                            pnpm install --registry=https://registry.npmmirror.com
                        fi
                        pnpm build
                    else
                        if [ ! -d "node_modules" ]; then
                            npm ci --registry=https://registry.npmmirror.com
                        fi
                        npm run build
                    fi
                    
                    cd ../..
                    
                    echo "✅ 前端构建完成"
                '''
            }
        }
        
        stage('🔨 Maven 编译后端') {
            steps {
                milestone(label: 'infra-monitor-build')
                sh '''
                    echo ">>> [infra-monitor] Maven 编译后端 <<<"
                    cd infra-monitor/infra-monitor-server
                    
                    mvn clean package -DskipTests -B -V -ntp -Pfast
                    
                    cd ../../
                    
                    echo "=== 编译产物 ==="
                    ls -lh infra-monitor/infra-monitor-server/target/*.jar | grep -v original || echo "⚠️ jar 不存在"
                '''
            }
        }
        
        stage('🚀 部署到 mykng') {
            steps {
                milestone(label: 'infra-monitor-deploy')
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                chmod +x /root/devtools/infra-monitor/ci/deploy.sh
                                bash /root/devtools/infra-monitor/ci/deploy.sh "${GIT_COMMIT}" "${env.GIT_BRANCH}"
                            """,
                            execTimeout: 600000
                        )],
                        verbose: true
                    )]
                )
            }
        }
        
        stage('✅ 健康检查') {
            steps {
                sshPublisher(
                    publishers: [sshPublisherDesc(
                        configName: 'mykng-deploy',
                        transfers: [sshTransfer(
                            execCommand: """
                                echo "--- Infra Monitor 健康检查 (端口 8085) ---"
                                for i in \$(seq 1 8); do
                                    if curl -sf http://localhost:8085/actuator/health > /dev/null 2>&1 || \\
                                       curl -sf http://localhost:8085/ > /dev/null 2>&1; then
                                        echo "✅ Infra Monitor 健康! (尝试 \$i)"
                                        exit 0
                                    fi
                                    sleep 8
                                done
                                echo "❌ 服务未响应"
                                exit 1
                            """,
                            execTimeout: 120000
                        )],
                        verbose: true
                    )]
                )
            }
        }
    }
    
    post {
        always {
            echo "============================================="
            echo "  infra-monitor 构建结束: ${currentBuild.result ?: 'SUCCESS'}"
            echo "============================================="
            cleanWs(cleanWhenNotFailed: false, deleteDirs: true)
        }
        success { echo "✅ infra-monitor 部署成功" }
        failure { echo "❌ infra-monitor 失败" }
    }
}
