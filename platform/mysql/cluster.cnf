[mysqld]
# ============================================================
# MySQL Group Replication 节点配置 — Node1 (mykng 192.168.31.105)
# ============================================================

# 基础配置
port = 3306
bind-address = 0.0.0.0
mysqlx = 0

# 二进制日志（GR 必需）
log_bin = binlog
binlog_format = ROW

# GTID 必需
gtid_mode = ON
enforce_gtid_consistency = ON
log_slave_updates = ON
binlog_checksum = NONE
master_info_repository = TABLE
relay_log_info_repository = TABLE
transaction_write_set_extraction = XXHASH64

# server-id 唯一
server-id = 1
report_host = 192.168.31.105

# Group Replication 多主模式
group_replication_group_name = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
group_replication_local_address = "192.168.31.105:33061"
group_replication_group_seeds = "192.168.31.105:33061,192.168.31.182:33061,192.168.31.182:33062"
group_replication_bootstrap_group = OFF
group_replication_start_on_boot = OFF
group_replication_single_primary_mode = OFF
group_replication_enforce_update_everywhere_checks = ON
